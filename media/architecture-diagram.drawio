        <mxCell id="title" value="&lt;b&gt;Adaptive Task Recovery for Humanoid Robots&lt;/b&gt;&lt;br&gt;System Architecture and Build Phases (simulation-only, ManiSkill3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=20;align=center;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">

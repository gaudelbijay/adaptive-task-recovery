        </mxCell>
        <mxCell id="legend_sw_6" value="&lt;b&gt;P6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=center;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="20" y="336" width="34" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend_tx_6" value="&lt;b&gt;Writeup &amp; Polish — repo cleanup, demo video, blog post&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;strokeColor=none;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="64" y="336" width="356" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sim_container" value="ManiSkill3 Simulator — GPU-vectorized SAPIEN backend (thousands of parallel envs). Everything inside this box runs purely in simulation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;dashed=1;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fontColor=#666666;spacingLeft=14;spacingTop=10;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="480" width="2460" height="780" as="geometry" />
        </mxCell>
        <mxCell id="sensors" value="&lt;b&gt;Raw Sensors (Simulated)  [P0]&lt;/b&gt;&lt;br&gt;RGB-D camera (head-mounted)&lt;br&gt;IMU: orientation, ang. vel., accel.&lt;br&gt;Joint encoders: pos / vel / torque&lt;br&gt;Per-link contact sensors&lt;br&gt;-&gt; raw sensor stream s_raw_t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="570" width="260" height="190" as="geometry" />
        </mxCell>
        <mxCell id="perception" value="&lt;b&gt;Perception / State Estimation  [P1]&lt;/b&gt;&lt;br&gt;RGB-D -&gt; object pose (seg+pose est,&lt;br&gt;  or ground-truth in sim)&lt;br&gt;IMU+encoders -&gt; base orientation,&lt;br&gt;  joint pos/vel/torque&lt;br&gt;Contacts -&gt; contact flags/forces&lt;br&gt;-&gt; state vector s_t" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="400" y="570" width="260" height="210" as="geometry" />
        </mxCell>
        <mxCell id="monitor" value="&lt;b&gt;Failure Monitor  [P3]&lt;/b&gt;&lt;br&gt;f(s_(t-k..t)) -&gt; nominal / failure&lt;br&gt;v1: threshold baseline (IMU tilt,&lt;br&gt;  F/T outlier, tracking error)&lt;br&gt;v2: ensemble dynamics-disagreement&lt;br&gt;v3: sequence anomaly model (LSTM/&lt;br&gt;  Transformer over obs window)&lt;br&gt;-&gt; FailureSignal{type, confidence,&lt;br&gt;  latency}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="740" y="570" width="260" height="220" as="geometry" />
        </mxCell>
        <mxCell id="arbiter" value="&lt;b&gt;Policy Arbiter  [P4]&lt;/b&gt;&lt;br&gt;Discrete switch each step:&lt;br&gt;  TASK | RECOVER(skill_id) | ABORT&lt;br&gt;v1: rule-based state machine on&lt;br&gt;  failure_type + confidence&lt;br&gt;v2 (stretch): learned selection&lt;br&gt;Safety skills always preempt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1080" y="570" width="240" height="210" as="geometry" />
        </mxCell>
        <mxCell id="taskpolicy" value="&lt;b&gt;Task Policy (per task)  [P1]&lt;/b&gt;&lt;br&gt;Baseline PPO/SAC, no failure-&lt;br&gt;awareness. One policy per task:&lt;br&gt;  PickPlaceRecovery&lt;br&gt;  DoorOpenRecovery&lt;br&gt;  CarryWalkRecovery&lt;br&gt;  PushRecoveryStand&lt;br&gt;Gate: &gt;90% nominal success rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="980" y="850" width="260" height="220" as="geometry" />
        </mxCell>
        <mxCell id="recoverylib_container" value="&lt;b&gt;Recovery Policy Library  [P4]  — options framework&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;verticalAlign=top;align=left;fontSize=12;fontStyle=1;dashed=1;spacingLeft=10;spacingTop=8;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1360" y="800" width="480" height="610" as="geometry" />
        </mxCell>
        <mxCell id="skill_regrasp" value="&lt;b&gt;regrasp — RL-trained&lt;/b&gt;&lt;br&gt;Trigger: grasp-slip / contact-loss,&lt;br&gt;object still in reach. release -&gt;&lt;br&gt;re-approach -&gt; re-grasp. Done: held." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1380" y="846" width="440" height="96" as="geometry" />
        </mxCell>
        <mxCell id="skill_reapproach" value="&lt;b&gt;re-approach — RL-trained&lt;/b&gt;&lt;br&gt;Trigger: reachable but approach&lt;br&gt;invalid (post-perturbation). back off&lt;br&gt;-&gt; replan approach -&gt; retry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1380" y="954" width="440" height="96" as="geometry" />
        </mxCell>
        <mxCell id="skill_step" value="&lt;b&gt;step-recovery (balance) — classical&lt;/b&gt;&lt;br&gt;Classical MPC / capture-point&lt;br&gt;controller. Trigger: CoM margin&lt;br&gt;violated / high tilt rate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1062" width="440" height="96" as="geometry" />
        </mxCell>
        <mxCell id="skill_replan" value="&lt;b&gt;replan-and-retry — RL-trained&lt;/b&gt;&lt;br&gt;Trigger: env changed (object moved,&lt;br&gt;stale plan). re-perceive -&gt; regenerate&lt;br&gt;sub-goals, or falls through to abort." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1170" width="440" height="96" as="geometry" />
        </mxCell>
        <mxCell id="skill_abort" value="&lt;b&gt;abort-to-safe-pose — safety backstop&lt;/b&gt;&lt;br&gt;Always initiable, always preempts.&lt;br&gt;Move to neutral pose, stop. Task&lt;br&gt;flagged failed — no silent retries." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1380" y="1278" width="440" height="96" as="geometry" />
        </mxCell>
        <mxCell id="wbc" value="&lt;b&gt;Whole-Body Controller /&lt;/b&gt;&lt;br&gt;Action Interface  [P1 infra]&lt;br&gt;Maps task-space/joint targets -&gt;&lt;br&gt;low-level joint commands&lt;br&gt;ManiSkill agent.set_action()&lt;br&gt;Same interface for task policy AND&lt;br&gt;every recovery skill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1940" y="570" width="260" height="190" as="geometry" />
        </mxCell>
        <mxCell id="robot" value="&lt;b&gt;Simulated Humanoid  [P0]&lt;/b&gt;&lt;br&gt;Unitree-style URDF/MJCF morphology,&lt;br&gt;imported as custom BaseAgent&lt;br&gt;Executes commands, physics updates&lt;br&gt;Smoke test: stands N sec under PD&lt;br&gt;control w/ randomized joint noise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2260" y="570" width="200" height="190" as="geometry" />
        </mxCell>
        <mxCell id="failinject" value="&lt;b&gt;Failure Injection Module  [P2]&lt;/b&gt;&lt;br&gt;external_force / friction_drop /&lt;br&gt;object_perturbation / sensor_dropout&lt;br&gt;/ actuator_fault / contact_loss&lt;br&gt;Deterministic (seeded), severity-&lt;br&gt;parameterized&lt;br&gt;Ground-truth onset+type logged&lt;br&gt;for evaluation only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2100" y="1010" width="260" height="220" as="geometry" />
        </mxCell>
        <mxCell id="evalharness" value="&lt;b&gt;Evaluation Harness  [P3-P5, packaged in P5]&lt;/b&gt;&lt;br&gt;Metrics: nominal/under-failure success,&lt;br&gt;  recovery success rate, time-to-recovery,&lt;br&gt;  detection precision/recall/latency,&lt;br&gt;  retry count&lt;br&gt;Baselines: no-recovery, scripted-recovery,&lt;br&gt;  blind-retry, monolithic-robust, oracle-detector&lt;br&gt;Ablations: detector type, curriculum on/off,&lt;br&gt;  held-out failure type &amp; severity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0B8299;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1420" width="620" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tl_0" value="&lt;b&gt;PHASE 0 — SETUP&lt;/b&gt;&lt;br&gt;Repo scaffold, Docker/CI skeleton&lt;br&gt;Install ManiSkill3, run example tasks&lt;br&gt;Import humanoid URDF as BaseAgent&lt;br&gt;Exit: standing-stability smoke test passes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="20" y="1780" width="340" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tl_1" value="&lt;b&gt;PHASE 1 — BASELINE POLICIES&lt;/b&gt;&lt;br&gt;Build PushRecoveryStand first, then&lt;br&gt;  PickPlace / DoorOpen / CarryWalk&lt;br&gt;Train Stage-0 policies per task&lt;br&gt;Exit: &gt;90% nominal success rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="380" y="1780" width="340" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tl_2" value="&lt;b&gt;PHASE 2 — FAILURE INJECTION&lt;/b&gt;&lt;br&gt;Implement failure-injection API&lt;br&gt;Sweep severities per failure type&lt;br&gt;Exit: documented severity curves&lt;br&gt;  per failure type per task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="740" y="1780" width="340" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tl_3" value="&lt;b&gt;PHASE 3 — FAILURE DETECTOR&lt;/b&gt;&lt;br&gt;Threshold -&gt; ensemble -&gt; sequence&lt;br&gt;  model, evaluated identically&lt;br&gt;Exit: beats threshold baseline on&lt;br&gt;  precision/recall for &gt;=2 types" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1100" y="1780" width="340" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tl_4" value="&lt;b&gt;PHASE 4 — RECOVERY POLICY (core)&lt;/b&gt;&lt;br&gt;Classical step-recovery controller&lt;br&gt;RL-trained regrasp/re-approach/replan&lt;br&gt;Rule-based arbiter wired end-to-end&lt;br&gt;Exit: beats no-recovery + scripted&lt;br&gt;  baselines, full ablation suite run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1460" y="1780" width="340" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tl_5" value="&lt;b&gt;PHASE 5 — GENERALIZATION &amp; BENCHMARK&lt;/b&gt;&lt;br&gt;Held-out failure type/severity eval&lt;br&gt;Package envs+API+baselines as a&lt;br&gt;  reproducible benchmark&lt;br&gt;Exit: benchmark runs from clean setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0B8299;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1820" y="1780" width="340" height="260" as="geometry" />
        </mxCell>
        <mxCell id="tl_6" value="&lt;b&gt;PHASE 6 — WRITEUP &amp; POLISH&lt;/b&gt;&lt;br&gt;Repo cleanup, README w/ GIFs/video&lt;br&gt;Blog-post writeup(s), demo video&lt;br&gt;Optional workshop-paper draft&lt;br&gt;Exit: portfolio-ready public repo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="2180" y="1780" width="340" height="260" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="s_raw_t" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="sensors" target="perception">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="s_t window" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="perception" target="monitor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="state s_t" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;dashed=1;" edge="1" parent="1" source="perception" target="arbiter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="failure_signal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;elbow=vertical;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="monitor" target="arbiter">

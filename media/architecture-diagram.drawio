        <mxCell id="legend_tx_3" value="&lt;b&gt;Failure Detector — threshold to ensemble to sequence-model monitor&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;strokeColor=none;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">

          <mxGeometry x="20" y="272" width="34" height="28" as="geometry" />
        </mxCell>
        <mxCell id="legend_tx_4" value="&lt;b&gt;Recovery Policy (core deliverable) — skill library + arbiter + full eval&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;spacingRight=6;fontFamily=Helvetica;strokeColor=none;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">

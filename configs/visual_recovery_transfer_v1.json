  "log_freq": 10,
  "learning_rate": 0.0001,
  "anneal_lr": true,
  "entropy_coefficient": 0.0,
  "value_coefficient": 0.5,
  "selection_failure_penalty": 2.0,
  "gamma": 0.95,
  "gae_lambda": 0.95

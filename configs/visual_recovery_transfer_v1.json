{
  "schema_version": 1,
  "name": "visual_recovery_transfer_v1",
  "seeds": [9351, 4796, 1788],
  "experiments": [{
    "method": "ordered_asymmetric_temporal_ppo",
    "env_id": "LearnedRecovery-v2",
    "registration_module": "atr.envs.learned_recovery",
